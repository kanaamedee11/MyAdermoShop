<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/ios_bg2"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Employee + Date + Expand/Collapse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewEmployeeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom de l'employé"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textViewDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/11/2024"
                    android:textColor="@color/ios_label2"
                    android:textSize="13sp"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/imageViewExpandCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Expand/Collapse"
                android:src="@drawable/ic_expand_more"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:background="@color/ios_sep"/>

        <!-- Collapsible product table -->
        <LinearLayout
            android:id="@+id/linearLayoutCollapsible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/tableLayoutProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stretchColumns="0">

                <!-- Static header row — data rows inflated by adapter -->
                <TableRow android:paddingBottom="6dp">
                    <TextView
                        android:text="Nom du Produit"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingEnd="12dp"
                        android:textColor="@color/ios_label2"/>
                    <TextView
                        android:text="Quantité Attendue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingEnd="12dp"
                        android:textColor="@color/ios_label2"/>
                    <TextView
                        android:text="Quantité Trouvée"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ios_label2"/>
                </TableRow>

            </TableLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>