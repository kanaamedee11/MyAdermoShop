<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <Space android:layout_width="0dp" android:layout_height="40dp"/>

        <ImageView
            android:id="@+id/imageViewIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_closure"
            android:contentDescription="Clôture"/>

        <Space android:layout_width="0dp" android:layout_height="32dp"/>

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clôture Réalisée"
            android:textColor="@color/ios_label"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <Space android:layout_width="0dp" android:layout_height="16dp"/>

        <TextView
            android:id="@+id/textViewMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Les données de clôture existent pour aujourd'hui. Action non autorisée."
            android:textColor="@color/ios_label2"
            android:textSize="17sp"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"/>

        <Space android:layout_width="0dp" android:layout_height="40dp"/>

        <!-- RESTORED: old ID -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="OK"
            android:textColor="@color/ios_btn_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/ios_btn"
            app:cornerRadius="12dp"
            app:elevation="0dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>