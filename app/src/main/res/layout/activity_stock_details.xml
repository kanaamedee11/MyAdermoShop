<?xml version="1.0" encoding="utf-8"?>
<!--
    ACTIVITY STOCK DETAILS — iOS Style
    All IDs from StockDetailsActivity.java:
      imageViewProduct, imageViewFacture
      textViewProductTitle, tvDecision
      textViewTotalAmount, textViewPieces,
      textViewManufactureDate, textViewExpirationDate,
      textViewSupplierName, textViewSupplierContact
      textViewPU, tvTotalAmountUsed,
      tvExpectedSellingAmount, tvBenefice,
      tvDate, tvUploadStatus
      buttonCreateInstances, progressBar, toolbar
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- ── Toolbar ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_nav"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_nav"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ios_blue"
            app:title="Détails du Stock"
            app:titleTextAppearance="@style/T.NavTitle"/>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ── Hero product image ── -->
            <ImageView
                android:id="@+id/imageViewProduct"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_product_placeholder_x"
                android:contentDescription="Product Image"/>

            <!-- ── Product title + decision badge ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/textViewProductTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Titre du Produit"
                    android:textColor="@color/ios_label"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/ios_green_bg"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <TextView
                        android:id="@+id/tvDecision"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="CONFIRMÉ"
                        android:textColor="@color/ios_green"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ── INFORMATIONS section ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INFORMATIONS"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:paddingStart="32dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <!-- Montant Total -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Montant Total"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewTotalAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Pièces -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Pièces"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewPieces"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Date de Fabrication -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Fabrication"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewManufactureDate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Date d'Expiration -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Expiration"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewExpirationDate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_green" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Fournisseur -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Fournisseur"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewSupplierName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Contact fournisseur -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Contact"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewSupplierContact"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_blue" android:textSize="17sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ANALYSE FINANCIÈRE section ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANALYSE FINANCIÈRE"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:paddingStart="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <!-- Montant Utilisé -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Montant Utilisé"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvTotalAmountUsed"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Prix de Vente Prévu -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Prix de Vente Prévu"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvExpectedSellingAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Bénéfice -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Bénéfice"
                            android:textColor="@color/ios_label" android:textSize="17sp"
                            android:textStyle="bold"/>
                        <TextView android:id="@+id/tvBenefice"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_green" android:textSize="17sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Prix par Unité -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Prix par Unité (P.U)"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/textViewPU"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Date -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Date"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvDate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="17sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Statut Téléchargement -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Statut Téléchargement"
                            android:textColor="@color/ios_label" android:textSize="17sp"/>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/ios_red_bg" app:cardCornerRadius="6dp"
                            app:cardElevation="0dp" app:strokeWidth="0dp">
                            <TextView android:id="@+id/tvUploadStatus"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:paddingStart="8dp" android:paddingEnd="8dp"
                                android:paddingTop="3dp" android:paddingBottom="3dp"
                                android:text="Non téléchargé"
                                android:textColor="@color/ios_red"
                                android:textSize="13sp" android:textStyle="bold"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── FACTURE section ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FACTURE"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:paddingStart="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:id="@+id/imageViewFacture"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_product_placeholder_x"
                    android:contentDescription="Facture Image"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Create instances button ── -->
            <com.google.android.material.button.MaterialButton
                style="@style/B.Primary"
                android:id="@+id/buttonCreateInstances"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:text="Créer les Barcodes (Instances)"
                android:visibility="gone"/>

            <!-- ── Progress bar ── -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="@color/ios_blue"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>