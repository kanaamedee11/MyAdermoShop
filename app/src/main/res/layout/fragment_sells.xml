<?xml version="1.0" encoding="utf-8"?>
<!-- SALES — iOS date filter pill + list -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_nav"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_nav"
            app:title="Ventes"
            app:titleTextAppearance="@style/T.NavTitle"/>
        <!-- Date filter strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <EditText
                    android:id="@+id/editTextStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Date début"
                    android:paddingStart="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ios_label"
                    android:textColorHint="@color/ios_placeholder"
                    android:textSize="15sp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <EditText
                    android:id="@+id/editTextEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Date fin"
                    android:paddingStart="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ios_label"
                    android:textColorHint="@color/ios_placeholder"
                    android:textSize="15sp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFilter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Filtrer"
                android:textColor="@color/ios_btn_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/ios_btn"
                app:cornerRadius="10dp"
                app:elevation="0dp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_sep"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSells"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
