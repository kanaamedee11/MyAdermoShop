<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_nav"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.iOS.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Ajouter un Versement"
            app:titleTextAppearance="@style/T.NavTitle"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="TYPE DE PAIEMENT"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Type de Paiement"
                        android:textColor="@color/ios_label"
                        android:textSize="17sp"/>

                    <Spinner
                        android:id="@+id/spinnerPaymentType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown"
                        android:background="@null"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="MONTANTS"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Montant Attendu"
                            android:textColor="@color/ios_label"
                            android:textSize="17sp"/>
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpectedAmount"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:enabled="false"
                            android:gravity="end"
                            android:hint="0.00 BIF"
                            android:inputType="numberDecimal"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/ios_label2"
                            android:textColorHint="@color/ios_placeholder"
                            android:textSize="17sp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Montant Versé"
                            android:textColor="@color/ios_label"
                            android:textSize="17sp"/>
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVersedAmount"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="end"
                            android:hint="0.00 BIF"
                            android:inputType="numberDecimal"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/ios_label"
                            android:textColorHint="@color/ios_placeholder"
                            android:textSize="17sp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Reste"
                            android:textColor="@color/ios_label"
                            android:textSize="17sp"/>
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etResteAmount"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:enabled="false"
                            android:gravity="end"
                            android:hint="0.00 BIF"
                            android:inputType="numberDecimal"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/ios_label2"
                            android:textColorHint="@color/ios_placeholder"
                            android:textSize="17sp"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="IMAGE DU VERSEMENT"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivSelectedImage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:src="@drawable/ic_product_placeholder_x"
                        android:scaleType="centerCrop"/>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:background="@color/ios_sep"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Justificatif"
                            android:textColor="@color/ios_label"
                            android:textSize="17sp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectImage"
                            style="@style/B.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Choisir"
                            android:textSize="14sp"
                            app:cornerRadius="10dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="0dp" android:layout_height="24dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddVersement"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:text="Ajouter le Versement"
        android:textColor="@color/ios_btn_text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="-0.004"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/ios_btn"
        app:cornerRadius="12dp"
        app:elevation="0dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>