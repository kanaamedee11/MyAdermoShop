<?xml version="1.0" encoding="utf-8"?>
<!-- NAV DRAWER HEADER — iOS profile card style -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@color/ios_bg3"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Avatar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <!-- Employee avatar — circular -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ios_sep"
            app:strokeWidth="0.5dp">
            <ImageView
                android:id="@+id/imageViewEmployee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Company icon — iOS rounded square -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="9dp"
            app:cardElevation="2dp">
            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_adermologo_round"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Name — Headline -->
    <TextView
        android:id="@+id/textViewEmployeeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="Nom Prénom"
        android:textColor="@color/ios_label"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="-0.004"/>

    <!-- Email — Footnote -->
    <TextView
        android:id="@+id/textViewEmployeeEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="email@adermo.com"
        android:textColor="@color/ios_label2"
        android:textSize="13sp"/>

</LinearLayout>
