<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="60dp"
    android:background="@color/ios_bg2" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginEnd="12dp" app:cardBackgroundColor="@color/ios_blue_bg"
        app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeWidth="0dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="8dp" android:src="@drawable/ic_inventory" app:tint="@color/ios_blue"/>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvProductName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Nom du produit"
            android:textColor="@color/ios_label" android:textSize="17sp"/>
        <TextView android:id="@+id/tvExpiry" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Contrôle physique"
            android:textColor="@color/ios_label2" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/tvExpectedQty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Prévu: 20"
            android:textColor="@color/ios_label2" android:textSize="13sp" android:gravity="end"/>
        <TextView android:id="@+id/tvActualQty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Réel: 18"
            android:textColor="@color/ios_red" android:textSize="13sp"
            android:textStyle="bold" android:gravity="end"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="›"
        android:textColor="@color/ios_label3" android:textSize="20sp"/>
</LinearLayout>
