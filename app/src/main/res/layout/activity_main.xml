<?xml version="1.0" encoding="utf-8"?>
<!-- MAIN with NavigationDrawer — iOS sheet-style drawer -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <FrameLayout
        android:id="@+id/frameLayoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ios_bg"/>

    <!-- Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ios_bg2"
        app:headerLayout="@layout/nav_header_main"
        app:itemBackground="@drawable/ios_nav_item_bg"
        app:itemIconTint="@color/ios_blue"
        app:itemTextColor="@color/ios_label"
        app:itemTextAppearance="@style/T.Body"
        app:menu="@menu/nav_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
