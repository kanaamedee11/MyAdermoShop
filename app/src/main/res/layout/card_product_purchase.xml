
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/ios_bg2" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <!--  ── Header: product name + total badge ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:id="@+id/textViewProductTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fanta Orange" android:textColor="@color/ios_label" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/textViewTotalAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="600 BIF" android:textColor="@color/ios_blue" android:textSize="17sp" android:textStyle="bold"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_sep"/>
        <!--  ── Pièces ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Pièces" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <TextView android:id="@+id/textViewPieces" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 pièces" android:textColor="@color/ios_label2" android:textSize="17sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="16dp" android:background="@color/ios_sep"/>
        <!--  ── Date de Fabrication ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fabrication" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <TextView android:id="@+id/textViewManufactureDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2024/01/29" android:textColor="@color/ios_label2" android:textSize="17sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="16dp" android:background="@color/ios_sep"/>
        <!--  ── Date d'Expiration ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Expiration" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <TextView android:id="@+id/textViewExpirationDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2024/10/24" android:textColor="@color/ios_green" android:textSize="17sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="16dp" android:background="@color/ios_sep"/>
        <!--  ── Fournisseur ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fournisseur" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <TextView android:id="@+id/textViewSupplierName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Barundi" android:textColor="@color/ios_label2" android:textSize="17sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="16dp" android:background="@color/ios_sep"/>
        <!--  ── Contact ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Contact" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <TextView android:id="@+id/textViewSupplierContact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="747 994" android:textColor="@color/ios_label2" android:textSize="17sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="16dp" android:background="@color/ios_sep"/>
        <!--  ── Décision badge ──  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Décision" android:textColor="@color/ios_label" android:textSize="17sp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardBackgroundColor="@color/ios_green_bg" app:cardCornerRadius="6dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <TextView android:id="@+id/tvDecision" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="CONFIRMÉ" android:textColor="@color/ios_green" android:textSize="13sp" android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_sep"/>
        <!--  ── Financial rows: 2-column layout ──  -->
        <!--  Montant Total Utilisé + Prix de Vente Prévu  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="4dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Montant Total Utilisé" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <TextView android:id="@+id/tvTotalAmountUsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="600 BIF" android:textColor="@color/ios_label" android:textSize="15sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prix de Vente Prévu" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <TextView android:id="@+id/tvExpectedSellingAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="900 BIF" android:textColor="@color/ios_label" android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--  Bénéfice + Prix par Unité  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="4dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bénéfice" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <TextView android:id="@+id/tvBenefice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="300 BIF" android:textColor="@color/ios_green" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prix par Unité (PU)" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <TextView android:id="@+id/textViewPU" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="30 BIF" android:textColor="@color/ios_label" android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--  Date + Statut Téléchargement  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="2024/11/21" android:textColor="@color/ios_label" android:textSize="15sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Statut Téléchargement" android:textColor="@color/ios_label2" android:textSize="12sp"/>
                <!--  Badge: swap cardBackgroundColor + textColor in adapter (red=not uploaded, green=uploaded)  -->
                <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:cardBackgroundColor="@color/ios_red_bg" app:cardCornerRadius="6dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <TextView android:id="@+id/tvUploadStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="Non Téléchargé" android:textColor="@color/ios_red" android:textSize="12sp" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
        <!--  ── Full separator before actions ──  -->
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_sep"/>
        <!--  ── Action buttons ──  -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="end">
            <!--  Annuler — destructive tinted  -->
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonCancel" style="@style/B.Destructive" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:text="Annuler" android:textSize="14sp" app:cornerRadius="10dp"/>
            <!--  Renvoyer — secondary/tinted  -->
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonResend" style="@style/B.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:text="Renvoyer" android:textSize="14sp" app:cornerRadius="10dp"/>
            <!--  Voir le Stock — primary  -->
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonViewStock" style="@style/B.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Voir le Stock" android:textSize="14sp" app:cornerRadius="10dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>