<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_nav"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_nav"
            app:title="Imprimante"
            app:titleTextAppearance="@style/T.NavTitle"/>
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_sep"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonScanPrinters"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:text="Scanner les imprimantes"
            android:textColor="@color/ios_btn_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/ios_btn"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/ios_btn_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:text="DISPONIBLES"
            android:textColor="@color/ios_label2"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.04"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ios_bg2"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ListView
                android:id="@+id/listViewPrinters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/ios_sep"
                android:dividerHeight="0.5dp"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
