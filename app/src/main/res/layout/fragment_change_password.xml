<?xml version="1.0" encoding="utf-8"?>
<!--
    FRAGMENT CHANGE PASSWORD — iOS Style

    Step 1: 8 single-digit PIN boxes (existing_password_1..8)
            + validate button (validate_existing_password_button)
    Step 2: Two 8-char password fields (new_password_1, new_password_2)
            locked until step 1 passes
    status_message — green on success, red on error
    update_button  — locked until step 1 passes
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- ── Section header: Mot de passe existant ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOT DE PASSE EXISTANT"
            android:textColor="@color/ios_label2"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="28dp"
            android:paddingBottom="10dp"/>

        <!-- 8 single-digit PIN boxes -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:weightSum="8">

            <EditText android:id="@+id/existing_password_1"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_2"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_3"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_4"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_5"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_6"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_7"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

            <EditText android:id="@+id/existing_password_8"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_margin="4dp"
                android:gravity="center" android:maxLength="1"
                android:inputType="numberPassword"
                android:background="@drawable/edit_text_outline"
                android:textColor="@color/ios_label"
                android:textSize="20sp" android:textStyle="bold"/>

        </LinearLayout>

        <!-- Validate button -->
        <com.google.android.material.button.MaterialButton
            style="@style/B.Secondary"
            android:id="@+id/validate_existing_password_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:text="Valider le mot de passe existant"/>

        <!-- ── Status message ── -->
        <TextView
            android:id="@+id/status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:textSize="14sp"
            android:text=""/>

        <!-- ── Section header: Nouveau mot de passe ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOUVEAU MOT DE PASSE"
            android:textColor="@color/ios_label2"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"/>

        <!-- New password card with two fields -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/ios_bg2"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/new_password_1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@null"
                    android:enabled="false"
                    android:gravity="center"
                    android:hint="Nouveau mot de passe"
                    android:textColorHint="@color/ios_placeholder"
                    android:maxLength="8"
                    android:inputType="numberPassword"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_sep"/>

                <EditText
                    android:id="@+id/new_password_2"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@null"
                    android:enabled="false"
                    android:gravity="center"
                    android:hint="Confirmer le mot de passe"
                    android:textColorHint="@color/ios_placeholder"
                    android:maxLength="8"
                    android:inputType="numberPassword"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Update button -->
        <com.google.android.material.button.MaterialButton
            style="@style/B.Primary"
            android:id="@+id/update_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Mettre à jour le mot de passe"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>