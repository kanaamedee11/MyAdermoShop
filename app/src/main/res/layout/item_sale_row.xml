<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM SALE ROW — iOS Style
    A single CartItem row. Inflated programmatically inside
    linearLayoutProducts of both item_sale_card and item_sale_simple.
    Column weights MUST match the headers in both parent cards:
      Produit (weight=2) | Quantité (weight=1) | P.U (weight=1) | Prix Total (weight=1)

    IDs used by both adapters: tvProductName, tvQty, tvUnitPrice, tvTotal
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="Produit"
            android:textColor="@color/ios_label"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/ios_label2"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvUnitPrice"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/ios_label2"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0 BIF"
            android:textColor="@color/ios_blue"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Inset separator between rows -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:background="@color/ios_sep"/>

</LinearLayout>