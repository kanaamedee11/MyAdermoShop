<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/ios_nav" app:elevation="0dp">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ios_nav"
        app:navigationIcon="@drawable/ic_menu"
        app:navigationIconTint="@color/ios_blue"
        app:titleTextAppearance="@style/T.NavTitle"/>
    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/ios_sep"/>
</com.google.android.material.appbar.AppBarLayout>
