<?xml version="1.0" encoding="utf-8"?>
<!--
    FRAGMENT THERMAL RECEIPT — iOS Style
    IDs: textViewCartID, textViewTime, textViewCurrency, textViewAmount,
         textViewEmployeeID, textViewEmployeeName, textViewEmployeeEmail,
         linearLayoutItems, buttonPrint
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_nav"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_nav"
            app:title="Reçu"
            app:titleTextAppearance="@style/T.NavTitle"/>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- ── PANIER section ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PANIER" android:textColor="@color/ios_label2"
                android:textSize="13sp" android:textAllCaps="true" android:letterSpacing="0.04"
                android:paddingStart="32dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2" app:cardCornerRadius="10dp"
                app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <!-- Cart ID -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="ID Panier"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewCartID"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label" android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Time -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Heure"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label" android:textSize="15sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Currency + Amount -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Montant Total"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewCurrency"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label2" android:textSize="15sp"
                            android:layout_marginEnd="4dp"/>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/ios_blue_bg" app:cardCornerRadius="8dp"
                            app:cardElevation="0dp" app:strokeWidth="0dp">
                            <TextView android:id="@+id/textViewAmount"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:paddingStart="10dp" android:paddingEnd="10dp"
                                android:paddingTop="5dp" android:paddingBottom="5dp"
                                android:textColor="@color/ios_blue" android:textSize="15sp"
                                android:textStyle="bold"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ARTICLES column headers ── -->
            <LinearLayout android:orientation="horizontal"
                android:layout_width="match_parent" android:layout_height="32dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:gravity="center_vertical" android:background="@color/ios_bg">
                <TextView android:layout_width="0dp" android:layout_weight="2"
                    android:layout_height="wrap_content" android:text="ARTICLE"
                    android:textColor="@color/ios_label2" android:textSize="12sp"
                    android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04"/>
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="end" android:text="QTÉ"
                    android:textColor="@color/ios_label2" android:textSize="12sp"
                    android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04"/>
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="end" android:text="P.U"
                    android:textColor="@color/ios_label2" android:textSize="12sp"
                    android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04"/>
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="end" android:text="TOTAL"
                    android:textColor="@color/ios_label2" android:textSize="12sp"
                    android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04"/>
            </LinearLayout>

            <!-- Articles card — rows injected programmatically by Java -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2" app:cardCornerRadius="10dp"
                app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:id="@+id/linearLayoutItems"
                    android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── EMPLOYÉ section ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="EMPLOYÉ" android:textColor="@color/ios_label2"
                android:textSize="13sp" android:textAllCaps="true" android:letterSpacing="0.04"
                android:paddingStart="32dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/ios_bg2" app:cardCornerRadius="10dp"
                app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <!-- Employee ID -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="ID"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewEmployeeID"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label" android:textSize="15sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Employee name -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Nom"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewEmployeeName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_label" android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:layout_marginStart="16dp" android:background="@color/ios_sep"/>

                    <!-- Employee email -->
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Email"
                            android:textColor="@color/ios_label2" android:textSize="15sp"/>
                        <TextView android:id="@+id/textViewEmployeeEmail"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/ios_blue" android:textSize="15sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Print button -->
    <com.google.android.material.button.MaterialButton
        style="@style/B.Primary"
        android:id="@+id/buttonPrint"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Imprimer le reçu"
        android:drawableStart="@drawable/ic_bluetooth"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>