<?xml version="1.0" encoding="utf-8"?>
<!-- SPLASH — iOS style: centered icon + name + spinner. No decorations. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- App icon: iOS rounded square, blue bg -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoCard"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardBackgroundColor="@color/ios_btn"
        app:cardCornerRadius="18dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_adermologo_round"
            android:contentDescription="@string/app_name"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- App name: Title1 -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textColor="@color/ios_label"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.007"
        app:layout_constraintBottom_toTopOf="@+id/tvLoadingStep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoCard"/>

    <!-- Current init step -->
    <TextView
        android:id="@+id/tvLoadingStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Initialisation…"
        android:textColor="@color/ios_label2"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/activityIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName"/>

    <!-- iOS activity indicator (small spinner) -->
    <ProgressBar
        android:id="@+id/activityIndicator"
        style="?android:attr/progressBarStyle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/ios_label2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLoadingStep"
        app:layout_constraintVertical_bias="0.0"/>

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="POS v2.0"
        android:textColor="@color/ios_label3"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>