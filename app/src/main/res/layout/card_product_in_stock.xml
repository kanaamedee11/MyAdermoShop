<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/ios_bg2"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Name + Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom du produit"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textViewId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRODUCT ID : PD1234"
                    android:textColor="@color/ios_label2"
                    android:textSize="12sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/textViewProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1500 BIF"
                android:textColor="@color/ios_blue"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:background="@color/ios_sep"/>

        <!-- Stock summary: total pieces -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Stock disponible"
                android:textColor="@color/ios_label2"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/textViewTotalProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27 pièces"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:background="@color/ios_sep"/>

        <!-- Last control info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/textViewLastControlDate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="10/12/2024 17:50"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/textViewExpectedQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendu : 23"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/textViewFoundQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trouvé : 23"
                android:textColor="@color/ios_label2"
                android:textSize="13sp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>

        <!-- Stock table -->
        <TableLayout
            android:id="@+id/stockTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:stretchColumns="0"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>