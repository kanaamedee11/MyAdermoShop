<?xml version="1.0" encoding="utf-8"?>
<!-- UPLOAD PROGRESS DIALOG — iOS grouped checklist
     Row IDs: rowDépenses, rowVersements, rowDTWI, rowDTWTI,
               rowClotures, rowChariots, rowPaiements
     Other IDs: tvDialogTitle, tvStepCounter, progressBar, buttonPrint
     Each row's icon badge (first child MaterialCardView) is updated
     programmatically: green bg + ✓ = done, blue bg + spinner = active,
     gray bg + ○ = waiting.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ios_bg2"
    app:cardCornerRadius="14dp"
    app:cardElevation="24dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNCHRONISATION"
                android:textColor="@color/ios_blue"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Téléchargement"
                    android:textColor="@color/ios_label"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvStepCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 7"
                    android:textColor="@color/ios_label2"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:max="7"
                android:progress="0"
                android:indeterminate="false"
                android:progressTint="@color/ios_blue"
                android:progressBackgroundTint="@color/ios_fill"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>

        <!-- ── Step 1: Dépenses ── -->
        <LinearLayout
            android:id="@+id/rowDépenses"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dépenses"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 2: Versements ── -->
        <LinearLayout
            android:id="@+id/rowVersements"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Versements"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 3: Produits détériorés (avec instance) ── -->
        <LinearLayout
            android:id="@+id/rowDTWI"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produits détériorés (instance)"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 4: Produits détériorés (sans instance) ── -->
        <LinearLayout
            android:id="@+id/rowDTWTI"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produits détériorés (sans instance)"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 5: Clôtures ── -->
        <LinearLayout
            android:id="@+id/rowClotures"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clôtures"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 6: Chariots ── -->
        <LinearLayout
            android:id="@+id/rowChariots"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chariots"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:layout_marginStart="62dp" android:background="@color/ios_sep"/>

        <!-- ── Step 7: Paiements ── -->
        <LinearLayout
            android:id="@+id/rowPaiements"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/ios_fill"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/ios_label3"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paiements"
                android:textColor="@color/ios_label2"
                android:textSize="17sp"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp"
            android:background="@color/ios_sep"/>

        <!-- ── Print / action button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrint"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="Imprimer la clôture"
            android:textColor="@color/ios_btn_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="-0.004"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/ios_btn"
            app:cornerRadius="12dp"
            app:elevation="0dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>